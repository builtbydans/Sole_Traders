<div class="max-w-5xl mx-auto space-y-10">
  <!-- HERO -->
    <section class="bg-white p-8 rounded-lg shadow">
      <h1 class="text-3xl font-bold mb-4">Public Directory</h1>

  <% if (result.length === 0) { %>
    <p class="text-center text-gray-500">No traders found.</p>
  <% } else { %>
      <form method="GET" action="/directory" class="flex gap-4 mb-6">

      <select name="trade_type">
        <option value="">All Trades</option>
        <option value="Plumber">Plumber</option>
        <option value="Electrician">Electrician</option>
        <option value="Builder">Builder</option>
        <option value="Roofer">Roofer</option>
        <option value="Decorator">Decorator</option>
        <option value="Handyman">Handyman</option>

      </select>

      <select name="region">
        <option value="">All Regions</option>
        <option value="London">London</option>
        <option value="Leeds">Leeds</option>
        <option value="Birmingham">Birmingham</option>
        <option value="Liverpool">Liverpool</option>
        <option value="Bristol">Bristol</option>

      </select>

      <button type="submit">Filter</button>

    </form>
    <ul class="space-y-4">
       <div class="flex justify-between">
         <span class="text-sm">
            Name
          </span>
          <span class="text-sm">
            Trade Type
          </span>
          <span class="text-sm">
            Region
          </span>
       </div>
      <% result.forEach(profile => { %>
        <li class="border rounded-lg p-2 hover:shadow-md transition-shadow">
           <a href="/directory/profile/<%= profile.id %>"
        class="block"
      >
          <div class="flex justify-between items-center">
            <span class="text-lg font-semibold text-blue-600">
              <%= profile.name %>
            </span>
            <span class="text-sm text-gray-500">
              <%= profile.trade_type %>
            </span>
            <span class="text-sm text-gray-500">
              <%= profile.region %>
            </span>
          </div>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

    <% if (trader) { %>
    <p class="text-lg">
      Welcome back,
      <span class="font-semibold"><%= trader.name %></span>
    </p>
    <a
      href="/logout"
      class="inline-block mt-4 text-sm text-red-600 hover:underline"
    >
      Logout
    </a>
    <% } else { %>

    <a
      href="/login"
      class="inline-block mt-4 bg-black text-white px-5 py-2 rounded hover:bg-gray-800 transition"
    >
      Trader Login
    </a>
    <% } %>
  </section>


  <!-- CTA -->
  <section class="bg-gray-50 p-8 rounded-lg text-center">
    <h2 class="text-xl font-semibold mb-2">Are you a sole trader?</h2>
    <p class="text-gray-600 mb-4">
      Join the platform and get discovered by local customers.
    </p>
    <a
      href="/register"
      class="inline-block bg-black text-white px-6 py-2 rounded hover:bg-gray-800 transition"
    >
      Register as a Trader
    </a>
  </section>
</div>
