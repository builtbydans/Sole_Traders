<div class="max-w-5xl mx-auto space-y-10">
      <% if (loggedOut) { %>
      <div class="max-w-5xl mx-auto mb-6 p-4 rounded bg-green-100 text-green-800 text-sm text-center">
        You have successfully logged out.
      </div>
    <% } %>
  <!-- HERO -->
  <section class="bg-white p-8 rounded-lg shadow text-center">
    <h1 class="text-3xl font-bold mb-4">Sole Traders App</h1>

    <% if (trader) { %>
    <p class="text-lg">
      Welcome back,
      <span class="font-semibold"><%= trader.name %></span>
    </p>
    <% } else { %>
    <p class="text-lg text-gray-700">
      Find trusted local sole traders near you.
    </p>
    <a
      href="/login"
      class="inline-block mt-4 bg-black text-white px-5 py-2 rounded hover:bg-gray-800 transition"
    >
      Trader Login
    </a>
    <% } %>
  </section>

